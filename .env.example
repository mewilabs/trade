# --- storage ---
SHEET_ID=                 # Google Sheet ID (from its URL)
GOOGLE_SA_JSON=           # service-account JSON (one line) OR set GOOGLE_SA_FILE
GOOGLE_SA_FILE=
# --- LLM (optional: rationales + Gift Nifty web-search fallback) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# --- Gift Nifty (optional manual/URL sources) ---
GIFT_NIFTY_OVERRIDE=      # type a number to force it for today's run
GIFT_NIFTY_URL=           # JSON endpoint you trust
GIFT_NIFTY_JSON_PATH=     # dotted path to the price in that JSON, e.g. data.lastPrice
# --- alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# --- risk settings ---
CAPITAL=500000
MIN_RR=1.5
VIX_SKIP_SCALP=22
